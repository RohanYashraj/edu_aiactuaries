# Copy to .env.local for local development. Never commit real values.
#
# Production/preview values live in the Vercel project settings, except the two
# vars marked "Convex-side" below, which are set on the Convex deployment with
# `npx convex env set ...`.

# --- Convex ---------------------------------------------------------------
# Written by `npx convex dev`. Do NOT set this on Vercel; CONVEX_DEPLOY_KEY
# takes its place there.
CONVEX_DEPLOYMENT=
# Set on Vercel for Production only. Preview builds get it injected by
# `convex deploy` (see build:vercel), so leave it unset for Preview.
NEXT_PUBLIC_CONVEX_URL=

# --- Clerk ----------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding

# --- Clerk -> Next webhook -> Convex --------------------------------------
# Signing secret of the Clerk webhook endpoint (/api/webhooks/clerk).
CLERK_WEBHOOK_SIGNING_SECRET=
# Shared secret guarding users.upsertFromClerk / users.deleteByClerkId.
# Must be identical here and on the Convex deployment.
CONVEX_WEBHOOK_SECRET=

# --- Convex-side only (npx convex env set <NAME> <value> [--prod]) ---------
# Clerk JWT issuer for the template named "convex", e.g. https://clerk.sssia.org
# CLERK_JWT_ISSUER_DOMAIN=
# CONVEX_WEBHOOK_SECRET=

# --- Site -----------------------------------------------------------------
# Defaults to https://sssia.org when unset (lib/site.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
